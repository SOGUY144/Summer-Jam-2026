--- !u!114 &950289223
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 950289218}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6462f38ec55318e42b4308458da913de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1172203209}
  lines:
  - text: "\u0E19\u0E35\u0E48\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E42\u0E25\u0E01\u2026"
    duration: 2
  - text: "\u0E41\u0E15\u0E48\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E35\u0E1A\u0E32\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E17\u0E35\u0E48\u0E04\u0E38\u0E49\u0E19\u0E40\u0E04\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E1C\u0E34\u0E14\u0E1B\u0E01\u0E15\u0E34"
    duration: 2
  - text: "\u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E21\u0E32\u2026\u0E08\u0E32\u0E01\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01"
    duration: 2
  - text: "\u0E41\u0E25\u0E30\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E21\u0E31\u0E19\u0E1E\u0E1A
      \u201C\u0E19\u0E49\u0E33\u201D"
    duration: 2
  - text: "\u0E21\u0E31\u0E19\u0E01\u0E47\u0E44\u0E21\u0E48\u0E22\u0E2D\u0E21\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E44\u0E1B"
    duration: 2
  - text: "\u0E41\u0E2B\u0E25\u0E48\u0E07\u0E19\u0E49\u0E33\u0E16\u0E39\u0E01\u0E1B\u0E34\u0E14\u0E01\u0E31\u0E49\u0E19"
    duration: 2
  - text: "\u0E16\u0E39\u0E01\u0E40\u0E01\u0E47\u0E1A\u0E0B\u0E48\u0E2D\u0E19"
    duration: 2
  - text: "\u0E23\u0E32\u0E27\u0E01\u0E31\u0E1A\u0E21\u0E31\u0E19\u0E44\u0E21\u0E48\u0E04\u0E27\u0E23\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E2D\u0E35\u0E01\u0E15\u0E48\u0E2D\u0E44\u0E1B"
    duration: 2
  - text: "\u0E44\u0E21\u0E48\u0E19\u0E32\u0E19\u2026\u0E2A\u0E07\u0E04\u0E23\u0E32\u0E21\u0E01\u0E47\u0E40\u0E23\u0E34\u0E48\u0E21\u0E02\u0E36\u0E49\u0E19"
    duration: 2
  - text: "\u0E19\u0E49\u0E33\u0E08\u0E32\u0E01\u0E2D\u0E14\u0E35\u0E15\u201D \u0E22\u0E31\u0E07\u0E04\u0E07\u0E16\u0E39\u0E01\u0E40\u0E01\u0E47\u0E1A\u0E23\u0E31\u0E01\u0E29\u0E32\u0E44\u0E27\u0E49"
    duration: 2
  - text: "\u0E41\u0E25\u0E30\u0E21\u0E35\u0E1A\u0E32\u0E07\u0E2A\u0E34\u0E48\u0E07\u0E16\u0E39\u0E01\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E02\u0E36\u0E49\u0E19"
    duration: 2
  - text: "\u0E08\u0E32\u0E01\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E19\u0E49\u0E33\u2026\u0E41\u0E15\u0E48\u0E40\u0E25\u0E35\u0E22\u0E19\u0E41\u0E1A\u0E1A\u0E21\u0E31\u0E19\u0E44\u0E14\u0E49"
    duration: 2
  - text: "\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E43\u0E2B\u0E49\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19"
    duration: 2
  - text: "\u0E02\u0E31\u0E1A\u0E40\u0E04\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E21\u0E37\u0E2D"
    duration: 2
  - text: "\u0E41\u0E25\u0E30\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E21\u0E42\u0E22\u0E07\u0E01\u0E31\u0E1A\u0E1A\u0E32\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u2026\u0E17\u0E35\u0E48\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E40\u0E02\u0E49\u0E32\u0E43\u0E08"
    duration: 2
  - text: .....
    duration: 2
  - text: "\u0E22\u0E34\u0E48\u0E07\u0E40\u0E27\u0E25\u0E32\u0E1C\u0E48\u0E32\u0E19\u0E44\u0E1B"
    duration: 2
  - text: "\u0E04\u0E27\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07\u0E22\u0E34\u0E48\u0E07\u0E1A\u0E34\u0E14\u0E40\u0E1A\u0E35\u0E49\u0E22\u0E27"
    duration: 2
  - text: "\u0E19\u0E49\u0E33\u0E17\u0E35\u0E48\u0E2B\u0E32\u0E22\u0E44\u0E1B"
    duration: 2
  - text: "\u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E17\u0E35\u0E48\u0E40\u0E1D\u0E49\u0E32\u0E21\u0E2D\u0E07"
    duration: 2
  - text: "\u0E41\u0E25\u0E30\u0E1A\u0E32\u0E07\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E16\u0E39\u0E01\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E02\u0E36\u0E49\u0E19\u2026"
    duration: 2
  - text: "\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C"
    duration: 2
  - text: "\u0E1A\u0E32\u0E07\u0E17\u0E35\u2026"
    duration: 2
  - text: "\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E30\u0E40\u0E01\u0E34\u0E14\u0E02\u0E36\u0E49\u0E19\u0E15\u0E48\u0E2D\u0E08\u0E32\u0E01\u0E19\u0E35\u0E49"
    duration: 2
  - text: "\u0E2D\u0E32\u0E08\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E01\u0E32\u0E23\u0E04\u0E49\u0E19\u0E2B\u0E32\u0E04\u0E27\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07"
    duration: 2
  - text: "\u0E2D\u0E32\u0E08\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E01\u0E32\u0E23\u0E04\u0E49\u0E19\u0E2B\u0E32\u0E04\u0E27\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07"
    duration: 2
  - text: 
    duration: 2
